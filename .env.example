# Required only for live Supabase-backed data; demo mode works without credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public threat-data endpoint; no API key required
RANSOMWHERE_API_BASE=https://ransomwhere.org/api
# Optional server-side threat intelligence providers
OTX_API_KEY=
ABUSEIPDB_API_KEY=
# Map tiles are supplied by OpenFreeMap by default (see README for attribution).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Protect scheduled/manual ingestion. Set a long random secret.
INGESTION_SECRET=
